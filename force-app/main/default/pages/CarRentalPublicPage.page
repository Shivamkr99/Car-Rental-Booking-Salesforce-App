<apex:page showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0" title="Car Rental Booking Platform">
    <html>
        <head>
            <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
            <title>Car Rental - Fleet Showroom</title>
            <apex:includeLightning />
            <style>
                * {
                    box-sizing: border-box;
                    margin: 0;
                    padding: 0;
                }
                body {
                    background-color: #0f172a;
                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                    min-height: 100vh;
                }
                #lightning-container {
                    width: 100%;
                    min-height: 100vh;
                }
            </style>
        </head>
        <body>
            <div id="lightning-container"></div>

            <script>
                $Lightning.use("c:CarRentalPublicApp", function() {
                    $Lightning.createComponent(
                        "c:carFleetExplorer",
                        {},
                        "lightning-container",
                        function(cmp) {
                            console.log("Car Fleet Explorer loaded on Public Force.com Site!");
                        }
                    );
                });
            </script>
        </body>
    </html>
</apex:page>
