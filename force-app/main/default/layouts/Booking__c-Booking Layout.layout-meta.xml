    <!-- ========================= -->

    <relatedLists>
        <relatedList>Payment__c.Booking__c</relatedList>
        <fields>NAME</fields>
        <fields>Amount__c</fields>
        <fields>Payment_Method__c</fields>
        <fields>Payment_Status__c</fields>
        <fields>Payment_Date__c</fields>
