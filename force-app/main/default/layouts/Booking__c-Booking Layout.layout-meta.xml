        <layoutColumns>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>OwnerId</field>
            </layoutItems>

            <layoutItems>
                <behavior>Readonly</behavior>
                <field>CreatedById</field>
            </layoutItems>

        </layoutColumns>

        <layoutColumns>

            <layoutItems>
                <behavior>Readonly</behavior>
                <field>LastModifiedById</field>
            </layoutItems>

        </layoutColumns>

        <style>TwoColumnsLeftToRight</style>
    </layoutSections>


    <!-- ========================= -->
