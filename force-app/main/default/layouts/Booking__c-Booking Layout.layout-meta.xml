            <layoutItems>
                <behavior>Required</behavior>
                <field>Booking_Type__c</field>
            </layoutItems>

        </layoutColumns>

        <layoutColumns>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>Status__c</field>
            </layoutItems>

            <layoutItems>
                <behavior>Required</behavior>
                <field>Pickup_Location__c</field>
            </layoutItems>

            <layoutItems>
                <behavior>Required</behavior>
                <field>Return_Location__c</field>
            </layoutItems>

            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Total_Amount__c</field>
            </layoutItems>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>Booking_Notes__c</field>
            </layoutItems>

        </layoutColumns>

        <style>TwoColumnsLeftToRight</style>
