<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- ========================= -->
    <!-- CAR INFORMATION -->
    <!-- ========================= -->
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Car Information</label>

        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Name</field>
            </layoutItems>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>Car_Model__c</field>
            </layoutItems>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>Brand__c</field>
            </layoutItems>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>Car_Type__c</field>
            </layoutItems>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>Fuel_Type__c</field>
            </layoutItems>
        </layoutColumns>

        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Transmission__c</field>
            </layoutItems>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>Seats__c</field>
            </layoutItems>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>Rating__c</field>
            </layoutItems>
        </layoutColumns>

        <style>TwoColumnsLeftToRight</style>
    </layoutSections>


    <!-- ========================= -->
