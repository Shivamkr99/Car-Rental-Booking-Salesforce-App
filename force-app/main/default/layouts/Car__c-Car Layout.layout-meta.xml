            </layoutItems>

            <layoutItems>
                <behavior>Edit</behavior>
                <field>Car_Image_URL__c</field>
            </layoutItems>
        </layoutColumns>

        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
